# Canonical production origin, with no trailing slash.
SITE_URL=https://truevedik.vercel.app

# International format digits only (country code + subscriber number).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=

# Booking email notifications use Resend. Use a verified sender domain.
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=
BOOKING_FROM_EMAIL=

# Analytics scripts stay disabled until a visitor accepts optional analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Payment adapter placeholder. Checkout is not enabled until an integration and prices are supplied.
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
