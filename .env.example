# ──────────────────────────────────────────────
# TrueVedic — Email Configuration (Gmail SMTP)
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# On Vercel, add these same 3 variables in: Project Settings > Environment Variables.
#
# HOW TO GET YOUR GMAIL APP PASSWORD:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Make sure 2-Step Verification is turned ON first
# 3. Select "Mail" as the app, choose your device
# 4. Copy the 16-digit password Google gives you
# 5. Paste it below (no spaces needed, but spaces are OK)

# Your Gmail address (used as the sender)
SMTP_EMAIL=mytruevedic@gmail.com

# Gmail App Password (16-digit, NOT your regular Gmail password)
SMTP_PASSWORD=lvjssfbaqktxgygq


# Where lead notification emails are sent (can be same as SMTP_EMAIL)
BOOKING_NOTIFICATION_EMAIL=mytruevedic@gmail.com
